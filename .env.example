# Add your Neon connection string to DATABASE_URL before using database features.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Use a random secret with at least 32 characters.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# One-time bootstrap secret and initial administrator details.
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-bootstrap-key
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=UniVote Administrator
